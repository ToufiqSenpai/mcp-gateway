// One Worker, one custom hostname, no env blocks. Replace the database_id and KV id
// with the values wrangler prints at provisioning time (see docs/RUNBOOK.md).
{
  "name": "mcp-gateway",
  "main": "packages/web/src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "gateway.example.com", "custom_domain": true }],
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-gateway",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": false }]
}
